# На хостинге DB_HOST часто localhost или адрес из панели (не всегда 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cz19567_alip
DB_USER=cz19567_alip
DB_PASS=alip232

DB_AUTO_INSTALL=true

# После первого успешного запуска на продакшене можно поставить false —
# схема сохраняется в storage/schema.lock, лишние проверки не нужны.

JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
JWT_TTL=86400

APP_ENV=local
APP_URL=https://skyclin.ru

# Почта (Timeweb SMTP)
MAIL_ENABLED=true
MAIL_HOST=smtp.timeweb.ru
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=info@cz19567.tw1.ru
MAIL_PASSWORD=your-mail-password
MAIL_FROM=info@cz19567.tw1.ru
MAIL_FROM_NAME=СкайКлин

# Кому приходят уведомления о новых заявках (через запятую)
ADMIN_EMAILS=info@cz19567.tw1.ru

# Домен для EHLO (обычно домен почты, например cz19567.tw1.ru)
MAIL_EHLO_DOMAIN=cz19567.tw1.ru

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram: ежедневная рассылка новостей РБК
TELEGRAM_NEWS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Канал: @yourchannel или -100xxxxxxxxxx (бот должен быть админом канала)
RBC_NEWS_RSS_URL=https://rssexport.rbc.ru/rbcnews/news/20/full.rss
RBC_NEWS_FETCH_LIMIT=30
TELEGRAM_NEWS_MAX_PER_RUN=10

# Секрет для вызова cron по URL (минимум 16 символов)
CRON_SECRET=change-me-to-long-random-secret
