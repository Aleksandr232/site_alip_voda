RewriteEngine On
RewriteBase /

# Передаём Authorization в PHP (нужно для JWT на Apache)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# www → без www (HTTPS не форсируем здесь — на Timeweb это даёт цикл)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --- SEO: дубли HTML → чистые URL ---
# Важно: THE_REQUEST — только реальный запрос браузера, не внутренний rewrite /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog\.html[\s?] [NC]
RewriteRule ^blog\.html$ /blog [R=301,L]

# Старый URL статьи с ?slug= → /article/slug
RewriteCond %{THE_REQUEST} \s/+blog-article\.(html|php)\?slug=([a-z0-9][a-z0-9-]*)[\s&] [NC]
RewriteRule ^blog-article\.(html|php)$ /article/%2? [R=301,L]

RewriteCond %{THE_REQUEST} \s/+article\.php\?slug=([a-z0-9][a-z0-9-]*)[\s&] [NC]
RewriteRule ^article\.php$ /article/%1? [R=301,L]

# Прямой заход на шаблон статьи без slug → блог
RewriteCond %{THE_REQUEST} \s/+blog-article\.(html|php)(?:\s|\?) [NC]
RewriteCond %{QUERY_STRING} !(^|&)slug= [NC]
RewriteRule ^blog-article\.(html|php)$ /blog [R=301,L]

RewriteCond %{THE_REQUEST} \s/+article\.php(?:\s|\?) [NC]
RewriteCond %{QUERY_STRING} !(^|&)slug= [NC]
RewriteRule ^article\.php$ /blog [R=301,L]

# Хвостовой слэш у блога и статей
RewriteCond %{THE_REQUEST} \s/+blog/\s [NC]
RewriteRule ^blog/$ /blog [R=301,L]

RewriteCond %{THE_REQUEST} \s/+article/([a-z0-9][a-z0-9-]*)/\s [NC]
RewriteRule ^article/([a-z0-9][a-z0-9-]*)/$ /article/$1 [R=301,L]

# Favicon для старых браузеров
RewriteRule ^favicon\.ico$ favicon.svg [L]
RewriteRule ^apple-touch-icon\.png$ apple-touch-icon.php [L]

# API: прямые PHP-файлы (partners.php, gallery.php…) — отдаём как есть, остальное — роутер
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(?:/(.*))?$ api/index.php [QSA,L]

# SEO: robots.txt и sitemap.xml генерируются PHP
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Чистые URL (внутренние rewrite — без внешнего редиректа)
RewriteRule ^$ index.html [L]
RewriteRule ^blog$ blog.html [L]
RewriteRule ^article/([a-z0-9][a-z0-9-]*)$ blog-article.php?slug=$1 [L,QSA]
RewriteRule ^article/?$ /blog [R=301,L]

RewriteRule ^login/?$ admin/login.php [L]
RewriteRule ^dashboard/?$ admin/dashboard.html [L]
RewriteRule ^requests/?$ admin/requests.html [L]
RewriteRule ^clients/?$ admin/clients.html [L]
RewriteRule ^posts/?$ admin/blog.html [L]
RewriteRule ^reviews/?$ admin/reviews.html [L]
RewriteRule ^gallery/?$ admin/gallery.html [L]
RewriteRule ^partners/?$ admin/partners.html [L]
RewriteRule ^settings/?$ admin/settings.html [L]

# Cron по URL (защита ключом в .env)
RewriteRule ^cron/rbc-news/?$ api/cron_rbc_news.php [L,QSA]

# Статические файлы и папки — не трогаем
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Редиректы со старых адресов админки
RewriteCond %{THE_REQUEST} \s/+admin/login\.(php|html)[\s?] [NC]
RewriteRule ^admin/login\.(php|html)$ /login [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/dashboard\.html[\s?] [NC]
RewriteRule ^admin/dashboard\.html$ /dashboard [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/requests\.html[\s?] [NC]
RewriteRule ^admin/requests\.html$ /requests [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/clients\.html[\s?] [NC]
RewriteRule ^admin/clients\.html$ /clients [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/blog\.html[\s?] [NC]
RewriteRule ^admin/blog\.html$ /posts [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/reviews\.html[\s?] [NC]
RewriteRule ^admin/reviews\.html$ /reviews [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/gallery\.html[\s?] [NC]
RewriteRule ^admin/gallery\.html$ /gallery [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/partners\.html[\s?] [NC]
RewriteRule ^admin/partners\.html$ /partners [R=301,L]

RewriteCond %{THE_REQUEST} \s/+admin/settings\.html[\s?] [NC]
RewriteRule ^admin/settings\.html$ /settings [R=301,L]

RewriteRule ^admin/?$ /login [R=301,L]
